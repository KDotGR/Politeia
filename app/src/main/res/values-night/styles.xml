<resources>
 <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:fontFamily">sans</item>
  <item name="android:colorAccent">@color/app_accent</item>
  <item name="android:colorBackground">@color/app_background</item>
  <item name="android:colorBackgroundFloating">@color/app_surface</item>
  <item name="android:textColorPrimary">@color/app_ink</item>
  <item name="android:textColorSecondary">@color/app_muted</item>
  <item name="android:windowLightStatusBar">false</item>
  <item name="android:windowLightNavigationBar">false</item>
  <item name="android:navigationBarColor">@color/app_background</item>
  <item name="android:statusBarColor">@color/app_background</item>
  <item name="android:windowActionModeOverlay">true</item>
  <item name="android:windowBackground">@color/app_background</item>
 </style>
</resources>
